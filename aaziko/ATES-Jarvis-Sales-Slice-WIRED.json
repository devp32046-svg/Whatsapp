    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ACTION-01 recheck + idempotency key (before send).\n  function hash(s){ let h=0; for(let i=0;i<s.length;i++){ h=(h*31+s.charCodeAt(i))|0; } return ('00000000'+(h>>>0).toString(16)).slice(-8); }\n  return $input.all().map(item => { const j = item.json; const p = JSON.stringify(j.draft);\n    return { json: Object.assign({}, j, { execGuard: { idempotencyKey: 'ACT-' + hash(p), rechecked: true } }) }; });"
      },
      "id": "rec",
      "name": "Recheck + Idempotency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3140,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
