        "mode": "runOnceForAllItems",
        "jsCode": "// QA blocked -> human review. Nothing sent.\n  return $input.all().map(item => { const j = item.json;\n    return { json: Object.assign({}, j, { humanReview: { queued: true, issues: (j.qa && j.qa.issues) || [], sendBlocked: true, outcome: 'BLOCKED_BY_QA' } }) }; });"
      },
