    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Assemble a BOUNDED context packet by re-sourcing each read node (avoids the mongo \"replaces output\" trap).\n  const S = $('Staging Input').first().json;\n  function pick(node){ try { const a = $(node).all(); return a.length ? a[0].json : {}; } catch(e){ return {}; } }\n  const company  = pick('Resolve Company');\n  const intel    = pick('Buyer Trade-Intel');\n  const supp     = pick('Suppression Check');\n  const crm      = pick('CRM / Comms History');\n  const tariff   = pick('Tariff');\n  const supplier = pick('Supplier Match');\n  const suppressed = !!(supp && Object.keys(supp).length);\n  return [{ json: {\n    staging: S,\n    context: {\n      facts: { buyer: { name: S.buyerName, email: S.buyerEmail, hs: S.hs, country: S.country },\n               company, intel, crm, tariff, supplier },\n      suppressed,\n      unknowns: ['exact field names - confirm via aaziko-discover.js'],\n      sourceRefs: ['common-service','Dhruval2'],\n      accessLimitations: 'read-only; bounded projection'\n    }\n  } }];"
      },
      "id": "asm",
      "name": "Assemble Context Packet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        520
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Deterministic commercial comparison. UNKNOWN inputs stay UNKNOWN - never invent.\n  return $input.all().map(item => { const j = item.json; const t = j.context.facts.tariff || {};\n    return { json: Object.assign({}, j, { commercial: {\n      dutyPct: (typeof t.dutyPct === 'number') ? t.dutyPct : 'UNKNOWN',\n      landedCost: 'UNKNOWN - NEEDS VERIFICATION' } }) }; });"
      },
      "id": "cmp",
      "name": "Commercial Comparison",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        520
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// COMM-01 decision. Suppression -> DO_NOT_CONTACT; Aaziko owes work -> internal task; else CONTACT.\n  return $input.all().map(item => { const j = item.json; const crm = j.context.facts.crm || {}; let decision, reason;\n    if (j.context.suppressed) { decision = 'DO_NOT_CONTACT'; reason = 'recipient in suppressions/unsubscribes'; }\n    else if (crm.aazikoOwes && crm.aazikoOwes.done === false) { decision = 'CREATE_INTERNAL_TASK'; reason = 'Aaziko owes work - finish our part first'; }\n    else { decision = 'CONTACT'; reason = 'open opportunity, no unfinished commitment'; }\n    return { json: Object.assign({}, j, { decision, decisionReason: reason }) }; });"
      },
      "id": "dec",
      "name": "Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        520
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "routec",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "CONTACT",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "route",
      "name": "Route (Contact vs Task)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2100,
        520
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// COMM-02 draft. PROD: replace with an LLM node using a bounded packet + SAFE_TO_SAY/DO_NOT_CLAIM.\n  return $input.all().map(item => { const j = item.json; const b = j.context.facts.buyer;\n    return { json: Object.assign({}, j, { draft: {\n      to: j.staging.testRecipient, subject: 'Aaziko - ' + b.hs + ' sourcing',\n      body: 'Hello ' + (b.name || 'there') + ',\\n\\nAaziko can help you source from qualified Indian suppliers and manage inspection, logistics and export documentation. Could you confirm your target specification and timeline so we can prepare a supported quotation?\\n\\nRegards,\\nAaziko Jarvis Communicator (AI assistant).',\n      note: 'PROD: LLM node here' } }) }; });"
      },
      "id": "draft",
      "name": "Draft (LLM in prod)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2320,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Independent QA - blocks unsupported claims + non-test recipient before any send.\n  return $input.all().map(item => { const j = item.json; const d = j.draft; const issues = [];\n    const forbidden = /\\$\\s?\\d|best price|duty savings|guaranteed/i;\n    if (forbidden.test(d.body)) issues.push('unsupported commercial claim');\n    if (!d.to || d.to.indexOf('test') === -1) issues.push('recipient not TEST inbox');\n    return { json: Object.assign({}, j, { qa: { qaPassed: issues.length === 0, issues } }) }; });"
      },
      "id": "qa",
      "name": "Independent QA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2520,
        400
      ]
    },
