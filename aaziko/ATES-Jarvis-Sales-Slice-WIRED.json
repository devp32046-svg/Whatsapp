        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.draft.to, subject: $json.draft.subject, body: $json.draft.body, testOnly: true }) }}",
        "options": {}
      },
      "id": "send",
      "name": "Send via outbound_email (TEST)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3340,
        320
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Shape the action-ledger record for aaziko_jarvis.actions.\n// Re-source from Recheck (the HTTP Send node replaces $input with its response/error).\nconst j = $('Recheck + Idempotency').item.json;\nconst co = (j.context && j.context.facts && j.context.facts.company) || {};\nreturn [{ json: {\n  action_id: 'ACT-' + Date.now(),\n  case_id: co._id || 'CASE-TBD',\n  action_type: 'EMAIL_SEND',\n  idempotencyKey: (j.execGuard && j.execGuard.idempotencyKey) || null,\n  state: 'SUCCEEDED_SIMULATED',\n  to: (j.draft && j.draft.to) || null,\n  at: new Date().toISOString()\n} }];"
      },
      "id": "ba",
      "name": "Build Action Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3540,
        320
      ]
    },
